/**
 * @file mqtt_config.h
 * @brief MQTT Client Library Configuration Header
 *
 * This file is automatically generated by CMake from mqtt_config.h.in
 * Do not edit this file directly - modify the CMakeLists.txt options instead.
 */

#ifndef MQTT_CONFIG_H
#define MQTT_CONFIG_H

#ifdef __cplusplus
extern "C" {
#endif

/*******************************************************************************
 * Version Information
 ******************************************************************************/

/** Major version number */
#define MQTT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** Minor version number */
#define MQTT_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** Patch version number */
#define MQTT_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** Full version string */
#define MQTT_VERSION_STRING "@PROJECT_VERSION@"

/** Combined version number (major * 10000 + minor * 100 + patch) */
#define MQTT_VERSION_NUMBER (@PROJECT_VERSION_MAJOR@ * 10000 + @PROJECT_VERSION_MINOR@ * 100 + @PROJECT_VERSION_PATCH@)

/*******************************************************************************
 * Protocol Version Support
 ******************************************************************************/

/** MQTT v3.1.1 protocol support */
#cmakedefine MQTT_ENABLE_V311

/** MQTT v5.0 protocol support */
#cmakedefine MQTT_ENABLE_V5

/*******************************************************************************
 * Transport Layer Configuration
 ******************************************************************************/

/** TLS/SSL transport support */
#cmakedefine MQTT_ENABLE_TLS

/** WebSocket transport support */
#cmakedefine MQTT_ENABLE_WEBSOCKET

/** TLS backend selection (1 = OpenSSL, 2 = mbedTLS) */
#if defined(MQTT_ENABLE_TLS)
    #if "@MQTT_TLS_BACKEND@" == "openssl"
        #define MQTT_TLS_BACKEND_OPENSSL 1
    #elif "@MQTT_TLS_BACKEND@" == "mbedtls"
        #define MQTT_TLS_BACKEND_MBEDTLS 1
    #endif
#endif

/*******************************************************************************
 * Threading and Concurrency
 ******************************************************************************/

/** Thread-safe operations enabled */
#cmakedefine MQTT_THREAD_SAFE

/*******************************************************************************
 * Memory Management
 ******************************************************************************/

/** Pool allocator enabled */
#cmakedefine MQTT_ENABLE_POOL_ALLOCATOR

/*******************************************************************************
 * Logging and Debugging
 ******************************************************************************/

/** Debug logging enabled */
#cmakedefine MQTT_ENABLE_LOGGING

/*******************************************************************************
 * Platform Detection
 ******************************************************************************/

/** Windows platform */
#cmakedefine MQTT_PLATFORM_WINDOWS

/** macOS platform */
#cmakedefine MQTT_PLATFORM_MACOS

/** Linux platform */
#cmakedefine MQTT_PLATFORM_LINUX

/** POSIX-compliant platform (macOS or Linux) */
#if defined(MQTT_PLATFORM_MACOS) || defined(MQTT_PLATFORM_LINUX)
    #define MQTT_PLATFORM_POSIX 1
#endif

/*******************************************************************************
 * Library Export/Import Macros
 ******************************************************************************/

#if defined(MQTT_SHARED_LIB)
    #if defined(MQTT_PLATFORM_WINDOWS)
        #if defined(MQTT_BUILDING_DLL)
            #define MQTT_API __declspec(dllexport)
        #else
            #define MQTT_API __declspec(dllimport)
        #endif
    #elif defined(__GNUC__) && __GNUC__ >= 4
        #define MQTT_API __attribute__((visibility("default")))
    #else
        #define MQTT_API
    #endif
#else
    #define MQTT_API
#endif

/*******************************************************************************
 * Protocol Limits and Constants
 ******************************************************************************/

/** Maximum MQTT packet size (256 MB) */
#ifndef MQTT_MAX_PACKET_SIZE
    #define MQTT_MAX_PACKET_SIZE (256 * 1024 * 1024)
#endif

/** Default buffer size for I/O operations (8 KB) */
#ifndef MQTT_DEFAULT_BUFFER_SIZE
    #define MQTT_DEFAULT_BUFFER_SIZE (8 * 1024)
#endif

/** Maximum number of in-flight messages (QoS > 0) */
#ifndef MQTT_MAX_INFLIGHT
    #define MQTT_MAX_INFLIGHT 20
#endif

/** Maximum client ID length (MQTT v3.1.1: 23, v5.0: 65535) */
#ifdef MQTT_ENABLE_V5
    #define MQTT_MAX_CLIENT_ID_LENGTH 65535
#else
    #define MQTT_MAX_CLIENT_ID_LENGTH 23
#endif

/** Maximum topic length */
#ifndef MQTT_MAX_TOPIC_LENGTH
    #define MQTT_MAX_TOPIC_LENGTH 65535
#endif

/** Maximum number of topic filters in a SUBSCRIBE packet */
#ifndef MQTT_MAX_SUBSCRIBE_TOPICS
    #define MQTT_MAX_SUBSCRIBE_TOPICS 16
#endif

/** Default keep-alive interval (seconds) */
#ifndef MQTT_DEFAULT_KEEPALIVE
    #define MQTT_DEFAULT_KEEPALIVE 60
#endif

/** Default connect timeout (milliseconds) */
#ifndef MQTT_DEFAULT_CONNECT_TIMEOUT
    #define MQTT_DEFAULT_CONNECT_TIMEOUT 30000
#endif

/** Default operation timeout (milliseconds) */
#ifndef MQTT_DEFAULT_TIMEOUT
    #define MQTT_DEFAULT_TIMEOUT 5000
#endif

/*******************************************************************************
 * Memory Pool Configuration (if enabled)
 ******************************************************************************/

#ifdef MQTT_ENABLE_POOL_ALLOCATOR
    /** Number of small blocks (64 bytes) in pool */
    #ifndef MQTT_POOL_SMALL_BLOCKS
        #define MQTT_POOL_SMALL_BLOCKS 32
    #endif

    /** Number of medium blocks (256 bytes) in pool */
    #ifndef MQTT_POOL_MEDIUM_BLOCKS
        #define MQTT_POOL_MEDIUM_BLOCKS 16
    #endif

    /** Number of large blocks (1024 bytes) in pool */
    #ifndef MQTT_POOL_LARGE_BLOCKS
        #define MQTT_POOL_LARGE_BLOCKS 8
    #endif
#endif

/*******************************************************************************
 * Feature Detection Macros
 ******************************************************************************/

/** Check if any MQTT version is enabled */
#if defined(MQTT_ENABLE_V311) || defined(MQTT_ENABLE_V5)
    #define MQTT_HAS_PROTOCOL_SUPPORT 1
#else
    #error "At least one MQTT protocol version must be enabled"
#endif

/** Check if any transport layer is available */
#define MQTT_HAS_TCP_TRANSPORT 1
#if defined(MQTT_ENABLE_TLS)
    #define MQTT_HAS_TLS_TRANSPORT 1
#endif
#if defined(MQTT_ENABLE_WEBSOCKET)
    #define MQTT_HAS_WS_TRANSPORT 1
#endif

/*******************************************************************************
 * Compiler and Standard Library Detection
 ******************************************************************************/

/** Check for C11 support */
#if __STDC_VERSION__ >= 201112L
    #define MQTT_HAS_C11 1
#endif

/** Check for C99 support */
#if __STDC_VERSION__ >= 199901L
    #define MQTT_HAS_C99 1
#endif

/** Static assertion macro */
#ifdef MQTT_HAS_C11
    #define MQTT_STATIC_ASSERT(cond, msg) _Static_assert(cond, msg)
#else
    #define MQTT_STATIC_ASSERT(cond, msg) \
        typedef char mqtt_static_assert_##__LINE__[(cond) ? 1 : -1]
#endif

/** Inline function macro */
#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 199901L
    #define MQTT_INLINE static inline
#elif defined(_MSC_VER)
    #define MQTT_INLINE static __inline
#else
    #define MQTT_INLINE static
#endif

/** Unreachable code marker */
#if defined(__GNUC__) || defined(__clang__)
    #define MQTT_UNREACHABLE() __builtin_unreachable()
#elif defined(_MSC_VER)
    #define MQTT_UNREACHABLE() __assume(0)
#else
    #define MQTT_UNREACHABLE() do { } while (0)
#endif

/** Likely/unlikely branch prediction hints */
#if defined(__GNUC__) || defined(__clang__)
    #define MQTT_LIKELY(x)   __builtin_expect(!!(x), 1)
    #define MQTT_UNLIKELY(x) __builtin_expect(!!(x), 0)
#else
    #define MQTT_LIKELY(x)   (x)
    #define MQTT_UNLIKELY(x) (x)
#endif

/*******************************************************************************
 * Debug and Assertion Macros
 ******************************************************************************/

#ifdef MQTT_ENABLE_LOGGING
    #define MQTT_LOG_ENABLED 1
#endif

/** Assertion macro (only in debug builds) */
#ifndef NDEBUG
    #include <assert.h>
    #define MQTT_ASSERT(expr) assert(expr)
#else
    #define MQTT_ASSERT(expr) ((void)0)
#endif

/*******************************************************************************
 * Deprecation and Compatibility Warnings
 ******************************************************************************/

#if defined(__GNUC__) || defined(__clang__)
    #define MQTT_DEPRECATED(msg) __attribute__((deprecated(msg)))
#elif defined(_MSC_VER)
    #define MQTT_DEPRECATED(msg) __declspec(deprecated(msg))
#else
    #define MQTT_DEPRECATED(msg)
#endif

/*******************************************************************************
 * Build Information
 ******************************************************************************/

/** Build timestamp (set at compile time) */
#define MQTT_BUILD_DATE __DATE__
#define MQTT_BUILD_TIME __TIME__

#ifdef __cplusplus
}
#endif

#endif /* MQTT_CONFIG_H */
